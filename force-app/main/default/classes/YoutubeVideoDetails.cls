    webservice static void details(String videoId,String recId)
    {
        
        
        String enckey=Youtube_Video_Integration__c.getInstance('API Key').Youtube_Video_Settings__c;
        System.debug('enckey '+enckey);
        String endpt=Youtube_Video_Integration__c.getInstance('Youtube Video Endpoint').Youtube_Video_Settings__c;
        System.debug('endpt '+endpt);
       
        endpt=endpt.replace('{API_KEY}',enckey); //in custom setting record, we keep {API_KEY} to replace here.
        endpt=endpt.replace('{VIDEO_ID}', videoId); //will come from calling
        System.debug('endpt '+endpt);
        HttpRequest httpReq = new HttpRequest();
        httpReq.setMethod('GET');
        httpReq.setEndpoint(endpt);
        HttpResponse httpResponse= new HTTP().send(httpReq);
        System.debug('httpResponse '+httpResponse);
        JsonParser js = (JsonParser)JSON.deserialize(httpResponse.getBody(), JsonParser.class);
        System.debug('JSON Raw '+js);
       
        Youtube_Video_Detail__c yv=new Youtube_Video_Detail__c();
        yv.Id=recId;
        yv.No_of_view_count__c=js.items[0].statistics.viewCount;
        yv.No_of_Likes__c=js.items[0].statistics.likeCount;
        yv.No_of_Dislikes__c=js.items[0].statistics.dislikeCount;
        yv.No_of_Comments__c=js.items[0].statistics.commentCount;
        update yv;
        
    }
